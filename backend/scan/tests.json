{
  "tests": [
    {
      "name": "OPTIONS preflight — 200",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Status check — 200",
      "method": "GET",
      "path": "/?action=status",
      "expectedStatus": 200
    },
    {
      "name": "GET с неизвестным action — 404",
      "method": "GET",
      "path": "/?action=unknown",
      "expectedStatus": 404
    },
    {
      "name": "POST photogrammetry без кадров — 400",
      "method": "POST",
      "path": "/?action=photogrammetry",
      "body": {"frames": []},
      "expectedStatus": 400
    },
    {
      "name": "POST photogrammetry с пустым body — 400",
      "method": "POST",
      "path": "/?action=photogrammetry",
      "body": {},
      "expectedStatus": 400
    }
  ]
}
